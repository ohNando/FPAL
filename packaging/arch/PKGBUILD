# Maintainer: ohNando <emirhanbuldurucu12@gmail.com>
pkgname=fpal
pkgver=0.7.1
pkgrel=1
pkgdesc='Fingerprint Auth for Linux: userspace driver, CLI and PAM module for Match-on-Chip sensors'
arch=('x86_64')
url='https://github.com/ohNando/FPAL'
license=('Apache-2.0')
depends=('pam' 'dbus')
makedepends=('gcc' 'make')
# The release tarball made by "make dist" (its top directory is fpal-$pkgver).
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	make CFLAGS_EXTRA=-Wno-error
}

check() {
	cd "$pkgname-$pkgver"
	make test CFLAGS_EXTRA=-Wno-error
}

package() {
	cd "$pkgname-$pkgver"
	make install DESTDIR="$pkgdir" PREFIX=/usr SBINDIR=/usr/bin \
		PAMDIR=/usr/lib/security LIBEXECDIR=/usr/lib/fpal \
		UNITDIR=/usr/lib/systemd/system \
		POLICYDIR=/usr/share/dbus-1/system.d
}
